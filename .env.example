# Public site URL (canonical, OG, sitemap)
NEXT_PUBLIC_SITE_URL=https://yottabuilder.ai
# WordPress backend that holds blog posts, job posts and Elementor Pro forms.
# After the cutover, point this at wherever WordPress keeps running (e.g. https://cms.yottabuilder.ai).
WP_BASE_URL=https://yottabuilder.ai
# Set to "1" to log form payloads instead of forwarding them (local QA only).
FORMS_DRY_RUN=
